<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>duocb</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The duocb core (Rust xcframework) this build links, so the version
	     footer can name it. Set from project.yml, which scripts/bump-xcframework.sh
	     keeps in step with the release pinned in Packages/Duocb/Package.swift. -->
	<key>DuocbCoreVersion</key>
	<string>$(DUOCB_CORE_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- No UIBackgroundModes: v1 is foreground-first. iOS suspends the app in
	     the background; the core's reconnect loop recovers on return to
	     foreground. No ATS exception either: nostr relays are wss:// and the
	     iroh QUIC/UDP transport is not ATS-governed. -->
	<!-- The local-network rendezvous is registered and resolved through the
	     system mDNSResponder daemon (Bonjour), which performs the multicast on
	     the app's behalf — so no multicast entitlement is involved. Browsing
	     requires the service type to be listed here and triggers the Local
	     Network permission prompt on first use.

	     BOTH types are load-bearing, and dropping either fails silently: the
	     app still compiles, links and launches, and the LAN lookup simply never
	     resolves, which reads like a network problem.
	       _duocb-pin._udp   the card-setup PIN rendezvous (trading cards)
	       _duocb-host._udp  the pairwise hosting record a clipboard session is
	                         found through — the dialer tries LAN before nostr
	     ci/ci.sh's `unsigned` job asserts both are present in the built app. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>duocb uses the local network to find your other device when trading cards and when sharing the clipboard, and to connect the two devices directly.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_duocb-pin._udp</string>
		<string>_duocb-host._udp</string>
	</array>
</dict>
</plist>
